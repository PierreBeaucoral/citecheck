# Copy to .env and fill in. .env is gitignored.

# Required for polite Crossref / OpenAlex requests (be a good citizen).
# See https://api.crossref.org/swagger-ui/index.html#/Etiquette
CITECHECK_CONTACT_EMAIL=pierre.beaucoral@uca.fr

# Optional — Semantic Scholar API key (free, register at https://www.semanticscholar.org/product/api).
# Without a key you get lower rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Optional — local Ollama endpoint (Phase 5).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional — GROBID endpoint (defaults to http://localhost:8070).
GROBID_HOST=http://localhost:8070
