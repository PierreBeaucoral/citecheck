\@writefile{toc}{\contentsline {paragraph}{L5 emerges as the strongest discriminator.}{28}{paragraph*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{L3 fires more on real references than on fabricated ones.}{28}{paragraph*.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-layer flag rate by ground-truth class on the 770-reference corpus, cache-clean rerun. L5 is the strongest single discriminator (12$\times $ class ratio). L3 is the one layer whose blue bar (real references) exceeds its red bar (fabricated) --- the inversion that motivates dropping it as an isolated existence check in future releases. Figure generated by \texttt  {scripts/make\_paper\_artifacts.py} from \texttt  {data/eval/results.json}.}}{30}{figure.caption.29}\protected@file@percent }
\newlabel{fig:per-layer-flag}{{5}{30}{Per-layer flag rate by ground-truth class on the 770-reference corpus, cache-clean rerun. L5 is the strongest single discriminator (12$\times $ class ratio). L3 is the one layer whose blue bar (real references) exceeds its red bar (fabricated) --- the inversion that motivates dropping it as an isolated existence check in future releases. Figure generated by \texttt {scripts/make\_paper\_artifacts.py} from \texttt {data/eval/results.json}}{figure.caption.29}{}}
\newlabel{fig:per-layer-flag@cref}{{[figure][5][]5}{[1][29][]30}{}{}{}}
